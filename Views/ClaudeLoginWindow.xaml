<Window x:Class="AIUsageMonitor.Views.ClaudeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Claude"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B2622"
        Foreground="#F7F5F0"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DAD2C1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEA69C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,5,8,5" />
            <Setter Property="Background" Value="#383330" />
            <Setter Property="Foreground" Value="#F7F5F0" />
            <Setter Property="CaretBrush" Value="#F7F5F0" />
            <Setter Property="BorderBrush" Value="#3F3A36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F7F5F0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22">
        <TextBlock x:Name="HeaderTextBlock"
                   Text="Add a Claude account"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <!-- Step 1: who -->
        <StackPanel x:Name="DetailsPanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Name for this account" />
            <TextBox x:Name="LabelTextBox" Style="{StaticResource Field}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Email of the account (optional)" />
            <TextBox x:Name="EmailTextBox" Style="{StaticResource Field}" />
            <TextBlock Style="{StaticResource Hint}"
                       Margin="0,6,0,0"
                       Text="The email is filled in on the sign-in page. If you sign in as a different account, the app rejects it and saves nothing." />
            <Button x:Name="GetLinkButton"
                    Margin="0,16,0,0"
                    Height="34"
                    HorizontalAlignment="Left"
                    Padding="16,0"
                    Content="Get sign-in link"
                    IsDefault="True"
                    Click="GetLinkButtonOnClick" />
        </StackPanel>

        <!-- Step 2: open the link, step 3: paste the code -->
        <StackPanel x:Name="SignInPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource StepTitle}" Margin="0,16,0,0" Text="1. Open the sign-in link" />
            <TextBlock x:Name="CheckAccountTextBlock"
                       Style="{StaticResource Hint}"
                       Margin="0,4,0,8" />
            <TextBox x:Name="LinkTextBox"
                     Style="{StaticResource Field}"
                     FontSize="12"
                     IsReadOnly="True" />
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="CopyLinkButton" Height="30" Padding="12,0" Content="Copy link" Click="CopyLinkButtonOnClick" />
                <Button x:Name="OpenPrivateButton" Height="30" Padding="12,0" Margin="8,0,0,0" Content="Open in private window" Click="OpenPrivateButtonOnClick" />
                <Button x:Name="OpenDefaultButton" Height="30" Padding="12,0" Margin="8,0,0,0" Content="Open in browser" Click="OpenDefaultButtonOnClick" />
            </WrapPanel>

            <TextBlock Style="{StaticResource StepTitle}" Margin="0,18,0,0" Text="2. Paste the code from the sign-in page" />
            <TextBox x:Name="CodeTextBox" Style="{StaticResource Field}" Margin="0,8,0,0" />
            <Button x:Name="FinishButton"
                    Margin="0,12,0,0"
                    Height="34"
                    HorizontalAlignment="Left"
                    Padding="16,0"
                    Content="Finish sign-in"
                    Click="FinishButtonOnClick" />
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="#AEA69C"
                   FontSize="12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="StartAgainButton"
                    Width="110"
                    Height="34"
                    Content="Start again"
                    Visibility="Collapsed"
                    Click="StartAgainButtonOnClick" />
            <Button x:Name="CancelButton"
                    Width="92"
                    Height="34"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButtonOnClick" />
        </StackPanel>
    </StackPanel>
</Window>
