<UserControl x:Class="AIUsageMonitor.Views.UsageTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AIUsageMonitor.ViewModels">
    <!-- The full-size overlay: one table, a group per provider, the same columns for every
         account (docs/adr/0001-overlay-account-table.md). VortexOne tokens. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="Ink" Color="#F7F5F0" />
        <SolidColorBrush x:Key="BodyStrong" Color="#DAD2C1" />
        <SolidColorBrush x:Key="Mute" Color="#AEA69C" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#2B2622" />
        <SolidColorBrush x:Key="CanvasSoft" Color="#383330" />
        <SolidColorBrush x:Key="CanvasRaised" Color="#423C38" />
        <SolidColorBrush x:Key="Hairline" Color="#3F3A36" />
        <SolidColorBrush x:Key="BorderStrong" Color="#918879" />
        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Mute}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Mute}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource CanvasRaised}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active / All: a two-part segmented control (VortexOne A22: no pill toggles). -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BodyStrong}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CanvasRaised}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scrollbar: a thumb on a transparent track, no arrow buttons. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,2,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BorderStrong}" CornerRadius="3" Opacity="0.6" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CellTemplate" DataType="{x:Type vm:UsageTableCell}">
            <Grid Margin="0,0,14,0">
                <TextBlock Text="—" Foreground="{StaticResource Mute}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasValue}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{Binding Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Foreground="{StaticResource Ink}"
                                   FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Style="{StaticResource SubText}" Text="{Binding SubText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="3" DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ActiveSegment" Style="{StaticResource Segment}" Content="Active" GroupName="ProviderFilter"
                                 IsChecked="{Binding ShowActiveProvidersOnly, Mode=TwoWay}" ToolTip="Hide providers with no usage or no data" />
                    <Border Width="1" Background="{StaticResource BorderStrong}" />
                    <RadioButton x:Name="AllSegment" Style="{StaticResource Segment}" Content="All" GroupName="ProviderFilter"
                                 IsChecked="{Binding ShowUnusedProviders, Mode=TwoWay}" ToolTip="Show every enabled provider" />
                </StackPanel>
            </Border>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Mute}"
                       Text="{Binding HiddenProvidersText}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding HiddenProvidersText}" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource CanvasSoft}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="14,9,14,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Eyebrow}" Text="ACCOUNT" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Text="SESSION" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="WEEK" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Eyebrow}" Text="OTHER LIMITS" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Eyebrow}" Text="CREDITS" />
                    <TextBlock Grid.Column="5" Style="{StaticResource Eyebrow}" Text="STATUS" />
                </Grid>

                <ScrollViewer x:Name="RowsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TableGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:UsageTableGroup}">
                                <StackPanel>
                                    <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource Hairline}"
                                            BorderThickness="0,1,0,0" Padding="14,6">
                                        <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding Eyebrow}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:UsageTableRow}">
                                                <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="14,10"
                                                        Background="Transparent" ToolTip="{Binding ToolTipText}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.3*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.3*" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AccountText}" Foreground="{StaticResource Ink}" FontSize="14"
                                                                       FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding AccountDetailText}" Foreground="{StaticResource Mute}" FontSize="12"
                                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding HasAccountDetail, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>

                                                        <ContentPresenter Grid.Column="1" Content="{Binding Session}" ContentTemplate="{StaticResource CellTemplate}" VerticalAlignment="Center" />
                                                        <ContentPresenter Grid.Column="2" Content="{Binding Week}" ContentTemplate="{StaticResource CellTemplate}" VerticalAlignment="Center" />
                                                        <ContentPresenter Grid.Column="3" Content="{Binding Other}" ContentTemplate="{StaticResource CellTemplate}" VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="4" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Foreground="{StaticResource Ink}" FontSize="13" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding CreditsText}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CreditsText}" Value="">
                                                                                <Setter Property="Text" Value="—" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Mute}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Style="{StaticResource SubText}" Text="{Binding CreditsDetailText}"
                                                                       Visibility="{Binding HasCreditsDetail, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Width="14" Height="14" Source="{Binding StatusIcon}" VerticalAlignment="Center" />
                                                            <TextBlock Margin="6,0,0,0" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}"
                                                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
