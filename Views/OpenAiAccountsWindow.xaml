<Window x:Class="AIUsageMonitor.Views.OpenAiAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenAI Accounts" Width="620" Height="540" MinWidth="580" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#2B2622" Foreground="#F7F5F0"
        Icon="/Assets/AppIcon.ico" ShowInTaskbar="False">
    <Border Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="OpenAI Accounts" FontSize="20" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="#AEA69C" FontSize="12"
                    Text="Sign into each ChatGPT account separately in your browser. Saved accounts keep their own cards when you change Codex's login. The Codex CLI must be installed." />
                <TextBlock x:Name="ModeText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#DAD2C1" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" Margin="0,14,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AccountsPanel" />
            </ScrollViewer>
            <StackPanel Grid.Row="3">
                <TextBlock Text="New account label" FontSize="12" Foreground="#AEA69C" />
                <TextBox x:Name="NewLabel" Height="30" Margin="0,5,0,0" Padding="6,3" Background="#383330"
                    Foreground="#F7F5F0" CaretBrush="#F7F5F0" BorderBrush="#3F3A36" />
                <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#AEA69C" FontSize="12" />
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddButton" Content="Add account" Width="120" Height="34" Click="AddOnClick" />
                    <Button x:Name="CancelLoginButton" Content="Cancel login" Width="120" Height="34" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelLoginOnClick" />
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Width="92" Height="34" Click="CloseOnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
