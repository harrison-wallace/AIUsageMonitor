<Window x:Class="AIUsageMonitor.Views.ProviderSetupInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        Height="240"
        MinWidth="460"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B2622"
        Foreground="#F7F5F0"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Border Padding="22"
            Background="#2B2622">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#F7F5F0" />

            <StackPanel Grid.Row="1"
                        Margin="0,18,0,0">
                <TextBlock x:Name="MessageTextBlock"
                           Foreground="#DAD2C1"
                           FontSize="13"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,14,0,0"
                           FontSize="13">
                    <Hyperlink Click="SetupHyperlinkOnClick">
                        <Run x:Name="SetupLinkRun" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button MinWidth="156"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Content="Open setup page"
                        Click="OpenSetupPageButtonOnClick" />
                <Button MinWidth="92"
                        Height="34"
                        Padding="14,0"
                        Content="Close"
                        Click="CloseButtonOnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
