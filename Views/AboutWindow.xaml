<Window x:Class="AIUsageMonitor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AI Usage Monitor"
        Width="540"
        Height="430"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B2622"
        Foreground="#F7F5F0"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Border Padding="22"
            Background="#2B2622">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#F7F5F0" />

                <TextBlock x:Name="VersionTextBlock"
                           Margin="0,5,0,0"
                           Foreground="#AEA69C"
                           FontSize="13" />

                <Border Margin="0,18,0,18"
                        Padding="16"
                        Background="#383330"
                        BorderBrush="#3F3A36"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Based on AIUsageMonitor by Seth A. Robinson"
                                   Foreground="#F7F5F0"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Windows tray app for checking remaining AI subscription usage across Anthropic, OpenAI/Codex, Antigravity, Gemini, and Cursor."
                                   Foreground="#AEA69C"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="Developed with significant assistance from AI tools."
                                   Foreground="#AEA69C"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Links"
                           Foreground="#DAD2C1"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <UniformGrid Margin="0,10,0,0"
                             Columns="2"
                             Rows="3">
                    <TextBlock Margin="0,0,12,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://github.com/SethRobinson/AIUsageMonitor"
                                   Foreground="#F7F5F0"
                                   Click="LinkOnClick">GitHub</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://www.rtsoft.com/"
                                   Foreground="#F7F5F0"
                                   Click="LinkOnClick">Homepage</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,12,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://www.codedojo.com/"
                                   Foreground="#F7F5F0"
                                   Click="LinkOnClick">Blog</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,10"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://twitter.com/rtsoft"
                                   Foreground="#F7F5F0"
                                   Click="LinkOnClick">Twitter</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,0,12,0"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://bsky.app/profile/rtsoft.com"
                                   Foreground="#F7F5F0"
                                   Click="LinkOnClick">Bluesky</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0"
                               FontSize="13">
                        <Hyperlink NavigateUri="https://mastodon.gamedev.place/@rtsoft"
                                   Foreground="#F7F5F0"
                                   Click="LinkOnClick">Mastodon</Hyperlink>
                    </TextBlock>
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button MinWidth="92"
                        Height="34"
                        Padding="14,0"
                        Content="Close"
                        Click="CloseButtonOnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
