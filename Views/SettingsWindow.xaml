<Window x:Class="AIUsageMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor Settings"
        Width="540"
        Height="700"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#2B2622"
        Foreground="#F7F5F0"
        Icon="/Assets/AppIcon.ico"
        ShowInTaskbar="False">
    <Border Padding="22"
            Background="#2B2622">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Settings"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#F7F5F0" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Update interval"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#DAD2C1" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox x:Name="UpdateIntervalTextBox"
                                     Width="96"
                                     Height="34"
                                     Padding="8,5"
                                     VerticalContentAlignment="Center"
                                     Background="#383330"
                                     BorderBrush="#918879"
                                     Foreground="#F7F5F0"
                                     CaretBrush="#F7F5F0"
                                     FontSize="14" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="minutes"
                                       Foreground="#AEA69C"
                                       FontSize="13" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Text="Default is 20. Manual refresh still runs immediately."
                                   Foreground="#AEA69C"
                                   FontSize="12" />

                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="UI scale"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#DAD2C1" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="UiScaleSlider"
                                        Minimum="80"
                                        Maximum="150"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="5"
                                        LargeChange="10"
                                        VerticalAlignment="Center"
                                        ValueChanged="UiScaleSliderOnValueChanged" />
                                <TextBlock x:Name="UiScaleValueTextBlock"
                                           Grid.Column="1"
                                           Width="56"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="#F7F5F0"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Scales the overlay text, controls, spacing, and progress bars."
                                       Foreground="#AEA69C"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <TextBlock Text="Providers"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#DAD2C1" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Enabled providers appear in the overlay and are included in refreshes."
                                   Foreground="#AEA69C"
                                   FontSize="12" />
                        <Border Margin="0,10,0,0"
                                Background="#383330"
                                BorderBrush="#3F3A36"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                    <Border Padding="12"
                                            BorderBrush="#423C38"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="AnthropicProviderEnabledCheckBox"
                                                          Content="Anthropic"
                                                          Foreground="#DAD2C1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Claude Code local OAuth and status-line quota data."
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <CheckBox x:Name="ClaudeStatusExporterCheckBox"
                                                          Margin="24,10,0,0"
                                                          Content="Install Claude Code status exporter automatically"
                                                          Foreground="#DAD2C1"
                                                          FontSize="12" />
                                                <TextBlock x:Name="AnthropicAccountsSummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Top">
                                                <Button Width="82"
                                                        Height="30"
                                                        Content="Setup"
                                                        Tag="Anthropic"
                                                        Click="ProviderSetupButtonOnClick" />
                                                <Button Width="82"
                                                        Height="30"
                                                        Margin="0,6,0,0"
                                                        Content="Accounts"
                                                        Click="AnthropicAccountsButtonOnClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#423C38"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="AnthropicApiCreditsProviderEnabledCheckBox"
                                                          Content="Anthropic API Credits"
                                                          Foreground="#DAD2C1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Saved Anthropic Console billing login for prepaid API credit balance."
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="AnthropicApiCreditsSummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Click="AnthropicApiCreditsSetupButtonOnClick" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#423C38"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="AntigravityProviderEnabledCheckBox"
                                                          Content="Antigravity"
                                                          Foreground="#DAD2C1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Local Antigravity language-server model quota."
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Tag="Antigravity"
                                                    Click="ProviderSetupButtonOnClick" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#423C38"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="OpenAiProviderEnabledCheckBox"
                                                          Content="OpenAI"
                                                          Foreground="#DAD2C1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Codex subscription usage, with independent saved accounts."
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="OpenAiAccountsSummaryTextBlock" Margin="24,8,0,0" Foreground="#AEA69C" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <Button
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Tag="OpenAI"
                                                    Click="ProviderSetupButtonOnClick" />
                                                <Button Width="82" Height="30" Margin="12,6,0,0" Content="Accounts" Click="OpenAiAccountsButtonOnClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            BorderBrush="#423C38"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="GeminiProviderEnabledCheckBox"
                                                          Content="Gemini"
                                                          Foreground="#DAD2C1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Gemini CLI credentials, Code Assist quota, quota status export, and local session data."
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Tag="Gemini"
                                                    Click="ProviderSetupButtonOnClick" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="CursorProviderEnabledCheckBox"
                                                          Content="Cursor"
                                                          Foreground="#DAD2C1"
                                                          FontSize="13"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Margin="24,4,0,0"
                                                           Text="Personal dashboard login or Teams Admin API spend data."
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="CursorModeSummaryTextBlock"
                                                           Margin="24,8,0,0"
                                                           Foreground="#AEA69C"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="82"
                                                    Height="30"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Content="Setup"
                                                    Click="CursorSetupButtonOnClick" />
                                        </Grid>
                                    </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <CheckBox x:Name="AlwaysOnTopCheckBox"
                                  Content="Always on top"
                                  Foreground="#DAD2C1"
                                  FontSize="13" />
                        <TextBlock Margin="24,4,0,0"
                                   Text="Keeps the overlay window above other windows. Turn off to let it behave like a normal window."
                                   Foreground="#AEA69C"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0">
                        <CheckBox x:Name="AutoRunAtLoginCheckBox"
                                  Content="Auto run at login"
                                  Foreground="#DAD2C1"
                                  FontSize="13" />
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0">
                        <CheckBox x:Name="DiagnosticLoggingCheckBox"
                                  Content="Diagnostic logging"
                                  Foreground="#DAD2C1"
                                  FontSize="13" />
                        <TextBlock Margin="24,4,0,0"
                                   Text="Writes detailed OpenAI/Codex refresh and quota info to the log (View Logs) for troubleshooting. Leave off for normal use."
                                   Foreground="#AEA69C"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="ValidationTextBlock"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="#EF8A7A"
                               FontSize="12" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Width="92"
                        Height="34"
                        HorizontalAlignment="Left"
                        Content="About"
                        Click="AboutButtonOnClick" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="92"
                            Height="34"
                            Margin="0,0,8,0"
                            Content="Cancel"
                            Click="CancelButtonOnClick" />
                    <Button Width="92"
                            Height="34"
                            Content="Save"
                            Click="SaveButtonOnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
